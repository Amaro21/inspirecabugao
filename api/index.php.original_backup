// Calculate age group from birth_date
function calcAgeGroup($birth_date) {
    if (!$birth_date) return 'adult';
    $age = (int)date_diff(date_create($birth_date), date_create('today'))->y;
    if ($age <= 11) return 'child';
    if ($age >= 60) return 'senior';
    return 'adult';
}

