    </button>
    <button class="mob-nav-btn admin-nav-tab" id="mnInc" onclick="showPage('incidents')" style="display:none">
      <span class="mob-nav-badge" id="mobIncBadge"></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Incidents
    </button>
    <button class="mob-nav-btn admin-nav-tab" id="mnAdmin" onclick="showPage('admin')" style="display:none">
      <span class="mob-nav-badge" id="mobAdminBadge"></span>
